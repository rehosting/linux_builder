From 52b03851d06677076eb355bfa98c0f71cb1cc3cc Mon Sep 17 00:00:00 2001
From: Luke Craig <lacraig3@gmail.com>
Date: Thu, 1 Oct 2026 19:36:54 -0400
Subject: [PATCH 41/42] igloo: drop the igloo_block_halt boot argument

Nothing sets it: Penguin never passes igloo_block_halt, and no igloo_driver
code reads it. Restores kernel/reboot.c to upstream.
---
 drivers/igloobase/igloo_args.c | 17 -----------------
 include/igloo.h                |  1 -
 kernel/reboot.c                | 18 ------------------
 3 files changed, 36 deletions(-)

diff --git a/drivers/igloobase/igloo_args.c b/drivers/igloobase/igloo_args.c
index 3674da3f..2f4e7310 100644
--- a/drivers/igloobase/igloo_args.c
+++ b/drivers/igloobase/igloo_args.c
@@ -29,23 +29,6 @@ static int __init early_igloo_task_size(char *p)
 early_param("igloo_task_size", early_igloo_task_size);
 EXPORT_SYMBOL(igloo_task_size);
 
-bool igloo_block_halt=false;
-
-static int __init early_igloo_block_halt(char *p)
-{
-    unsigned long block_halt;
-    if (kstrtoul(p, 0, &block_halt) < 0 ) {
-        pr_emerg("Could not parse igloo_block_halt parameter %s. Set to 0 (default) or 1\n", p);
-        return -1;
-    }
-    igloo_block_halt = (block_halt > 0);
-    pr_emerg_once("Using igloo_block_halt: %d\n", igloo_block_halt);
-    return 0;
-}
-
-early_param("igloo_block_halt", early_igloo_block_halt);
-EXPORT_SYMBOL(igloo_block_halt);
-
 // Debug logging configuration for each module
 struct igloo_debug_config {
     bool portal;       // Enable debug for portal module
diff --git a/include/igloo.h b/include/igloo.h
index 1de6832e..b1627b81 100644
--- a/include/igloo.h
+++ b/include/igloo.h
@@ -5,7 +5,6 @@
 #include <linux/binfmts.h>
 
 extern unsigned long igloo_task_size; // mmap.c
-extern bool igloo_block_halt; // reboot.c
 
 struct user_arg_ptr;  // Forward declaration
 struct syscall_metadata; // Forward declaration for syscall metadata functions
diff --git a/kernel/reboot.c b/kernel/reboot.c
index c1a451d4..bd30a973 100644
--- a/kernel/reboot.c
+++ b/kernel/reboot.c
@@ -16,7 +16,6 @@
 #include <linux/syscalls.h>
 #include <linux/syscore_ops.h>
 #include <linux/uaccess.h>
-#include <igloo.h>
 
 /*
  * this indicates whether you can reboot with ctrl-alt-del: the default is yes
@@ -214,10 +213,6 @@ void migrate_to_reboot_cpu(void)
  */
 void kernel_restart(char *cmd)
 {
-	if (igloo_block_halt) {
-		printk("IGLOO: refusing to restart\n");
-		return;
-	}
 	kernel_restart_prepare(cmd);
 	migrate_to_reboot_cpu();
 	syscore_shutdown();
@@ -245,10 +240,6 @@ static void kernel_shutdown_prepare(enum system_states state)
  */
 void kernel_halt(void)
 {
-	if (igloo_block_halt) {
-		printk("IGLOO: refusing to halt\n");
-		return;
-	}
 	kernel_shutdown_prepare(SYSTEM_HALT);
 	migrate_to_reboot_cpu();
 	syscore_shutdown();
@@ -265,10 +256,6 @@ EXPORT_SYMBOL_GPL(kernel_halt);
  */
 void kernel_power_off(void)
 {
-	if (igloo_block_halt) {
-		printk("IGLOO: refusing to power off\n");
-		return;
-	}
 	kernel_shutdown_prepare(SYSTEM_POWER_OFF);
 	if (pm_power_off_prepare)
 		pm_power_off_prepare();
@@ -297,11 +284,6 @@ SYSCALL_DEFINE4(reboot, int, magic1, int, magic2, unsigned int, cmd,
 	char buffer[256];
 	int ret = 0;
 
-	if (igloo_block_halt) {
-		printk("IGLOO: refusing to reboot\n");
-		return -EPERM;
-	}
-
 	/* We only trust the superuser with rebooting the system. */
 	if (!ns_capable(pid_ns->user_ns, CAP_SYS_BOOT))
 		return -EPERM;
